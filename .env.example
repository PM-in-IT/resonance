APP_ENV=dev
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://resonance:resonance@postgres:5432/resonance

REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=media
PROCESSING_JOB_TIMEOUT_SECONDS=1800
PROCESSING_JOB_RESULT_TTL_SECONDS=3600

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads

MAX_UPLOAD_BYTES=104857600
MAX_MEDIA_DURATION_SECONDS=600

EMBEDDING_DIMENSION=0
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_DEVICE=cpu

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8